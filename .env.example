# Proveedor de LLM (openrouter, openai, anthropic, ollama, or mock)
LLM_PROVIDER=openrouter

# API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Para Ollama local
OLLAMA_BASE_URL=http://localhost:11434

# Para OpenRouter (compatible con OpenAI SDK, LangChain)
OPENROUTER_API_KEY=sk-or-v1-tu-api-key-aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelo de embeddings (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Modelo de reranker
RERANKER_MODEL=ms-marco-MiniLM-L-6-v2

# Modelo de chat en OpenRouter (formato: proveedor/modelo)
# Para modelos gratuitos usa el sufijo :free (ej: nvidia/nemotron-3-ultra-550b-a55b:free)
# O usa el router automático: openrouter/free
CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# LangChain config
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=FarmaBot

# Parámetros del LLM
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Procesamiento de documentos
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Recuperación
TOP_K_RETRIEVAL=20
TOP_K_FINAL=5
SIMILARITY_THRESHOLD=0.30

# Base de datos vectorial
VECTOR_DB_PATH=data/chroma_db
COLLECTION_NAME=farmaco_docs

# Ruta de documentos
DOCUMENTS_PATH=data/documents
