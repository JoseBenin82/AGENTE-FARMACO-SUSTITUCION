# Proveedor de LLM (openai, anthropic, ollama, openrouter, or mock)
LLM_PROVIDER=mock

# API Keys (solo si usas OpenAI/Anthropic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Para Ollama local
OLLAMA_BASE_URL=http://localhost:11434

# Para OpenRouter (compatible con OpenAI SDK, modelos gratuitos disponibles)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelo de embeddings (sentence-transformers o text-embedding-ada-002)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Modelo de reranker
RERANKER_MODEL=ms-marco-MiniLM-L-6-v2

# Modelo de chat
CHAT_MODEL=gpt-4o-mini

# Base de datos vectorial
VECTOR_DB_PATH=data/chroma_db
COLLECTION_NAME=farmaco_docs

# Ruta de documentos
DOCUMENTS_PATH=data/documents
